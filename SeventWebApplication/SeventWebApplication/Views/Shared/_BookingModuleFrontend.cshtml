
@{
                                                                    <title>Sevent Biluthyrning</title>
                                                                    <meta name="claude:viewport-fit-sides" content="cover">

                                                                    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">

                                                                    <style>
                                                                        /* Sevent design system — Void Purple palette */
                                                                        :root {
                                                                            --void: #392C59;
                                                                            --accent: #8E79C6;
                                                                            --lavender: #E7E0F5;
                                                                            --light-bg: #F5F5F8;
                                                                            --dark-bg: #1F2430;
                                                                            --bg: #F5F5F8;
                                                                            --surface: #ffffff;
                                                                            --border: #E7E0F5;
                                                                            --text: #1F2430;
                                                                            --text-muted: #7a7a9a;
                                                                            --pill-bg: #F0EDF9;
                                                                            --cta-bg: #6C55B8;
                                                                            --cta-hover: #5a45a0;
                                                                            --tab-active-bg: #1F2430;
                                                                            --tab-active-text: #ffffff;
                                                                            --tab-inactive-text: #5a5a7a;
                                                                            --shadow: 0 4px 24px rgba(57,44,89,0.13);
                                                                            --radius: 14px;
                                                                        }

                                                                        @@media (prefers-color-scheme: dark) {
                                                                            : root:not([data-theme="light"])

                                                                        {
                                                                            --bg: #13101e;
                                                                            --surface: #1e1a2e;
                                                                            --border: #2e2848;
                                                                            --text: #f0edf9;
                                                                            --text-muted: #9b94be;
                                                                            --pill-bg: #2a2440;
                                                                            --tab-active-bg: #8E79C6;
                                                                            --tab-active-text: #1F2430;
                                                                            --tab-inactive-text: #9b94be;
                                                                            --shadow: 0 4px 24px rgba(0,0,0,0.4);
                                                                            color-scheme: dark;
                                                                        }

                                                                        }

                                                                        :root[data-theme="dark"] {
                                                                            --bg: #13101e;
                                                                            --surface: #1e1a2e;
                                                                            --border: #2e2848;
                                                                            --text: #f0edf9;
                                                                            --text-muted: #9b94be;
                                                                            --pill-bg: #2a2440;
                                                                            --tab-active-bg: #8E79C6;
                                                                            --tab-active-text: #1F2430;
                                                                            --tab-inactive-text: #9b94be;
                                                                            --shadow: 0 4px 24px rgba(0,0,0,0.4);
                                                                            color-scheme: dark;
                                                                        }

                                                                        *, *::before, *::after {
                                                                            box-sizing: border-box;
                                                                            margin: 0;
                                                                            padding: 0;
                                                                        }

                                                                        .sevent-widget {
                                                                            font-family: 'Inter', system-ui, sans-serif;
                                                                            background: var(--bg);
                                                                            color: var(--text);
                                                                            display: flex;
                                                                            flex-direction: column;
                                                                            align-items: center;
                                                                            justify-content: center;
                                                                            padding-block: 40px;
                                                                            padding-left: max(16px, env(safe-area-inset-left, 0px));
                                                                            padding-right: max(16px, env(safe-area-inset-right, 0px));
                                                                            gap: 24px;
                                                                        }

                                                                        /* Logo */
                                                                        .logo {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 10px;
                                                                            margin-bottom: 4px;
                                                                        }

                                                                        .logo-mark {
                                                                            width: 38px;
                                                                            height: 38px;
                                                                        }

                                                                        .logo-text {
                                                                            font-size: 26px;
                                                                            font-weight: 700;
                                                                            color: var(--text);
                                                                            letter-spacing: -0.5px;
                                                                        }

                                                                        .tagline {
                                                                            font-size: 13px;
                                                                            color: var(--text-muted);
                                                                            text-align: center;
                                                                            margin-top: 2px;
                                                                        }

                                                                        /* Card */
                                                                        .card {
                                                                            background: var(--surface);
                                                                            border-radius: var(--radius);
                                                                            box-shadow: var(--shadow);
                                                                            padding: 22px 24px 24px;
                                                                            width: 100%;
                                                                            max-width: 1200px;
                                                                        }

                                                                        /* Top row */
                                                                        .top-row {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            justify-content: space-between;
                                                                            margin-bottom: 18px;
                                                                            flex-wrap: wrap;
                                                                            gap: 10px;
                                                                        }

                                                                        .tabs {
                                                                            display: flex;
                                                                            gap: 8px;
                                                                        }

                                                                        .tab {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 7px;
                                                                            padding: 8px 18px;
                                                                            border-radius: 999px;
                                                                            border: none;
                                                                            cursor: pointer;
                                                                            font-family: inherit;
                                                                            font-size: 14px;
                                                                            font-weight: 500;
                                                                            transition: background 0.15s, color 0.15s;
                                                                            background: transparent;
                                                                            color: var(--tab-inactive-text);
                                                                        }

                                                                            .tab.active {
                                                                                background: var(--tab-active-bg);
                                                                                color: var(--tab-active-text);
                                                                            }

                                                                        .manage-link {
                                                                            font-size: 13px;
                                                                            color: var(--text-muted);
                                                                            text-decoration: underline;
                                                                            text-underline-offset: 2px;
                                                                            cursor: pointer;
                                                                            background: none;
                                                                            border: none;
                                                                            font-family: inherit;
                                                                            white-space: nowrap;
                                                                        }

                                                                        /* Vehicle category pills */
                                                                        .categories-label {
                                                                            font-size: 11px;
                                                                            font-weight: 600;
                                                                            text-transform: uppercase;
                                                                            letter-spacing: 0.06em;
                                                                            color: var(--text-muted);
                                                                            margin-bottom: 10px;
                                                                        }

                                                                        .categories {
                                                                            display: flex;
                                                                            gap: 8px;
                                                                            flex-wrap: wrap;
                                                                            margin-bottom: 18px;
                                                                        }

                                                                        .cat-pill {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 7px;
                                                                            padding: 7px 14px;
                                                                            border-radius: 999px;
                                                                            border: 1.5px solid var(--border);
                                                                            background: var(--pill-bg);
                                                                            cursor: pointer;
                                                                            font-family: inherit;
                                                                            font-size: 13px;
                                                                            font-weight: 500;
                                                                            color: var(--text-muted);
                                                                            transition: border-color 0.15s, color 0.15s, background 0.15s;
                                                                            white-space: nowrap;
                                                                        }

                                                                            .cat-pill:hover {
                                                                                border-color: var(--accent);
                                                                                color: var(--accent);
                                                                            }

                                                                            .cat-pill.active {
                                                                                border-color: var(--accent);
                                                                                background: var(--lavender);
                                                                                color: var(--void);
                                                                            }

                                                                        @@media (prefers-color-scheme: dark) {
                                                                            : root:not([data-theme="light"]) .cat-pill.active

                                                                        {
                                                                            background: #2e2848;
                                                                            color: var(--accent);
                                                                        }

                                                                        }

                                                                        :root[data-theme="dark"] .cat-pill.active {
                                                                            background: #2e2848;
                                                                            color: var(--accent);
                                                                        }

                                                                        .cat-pill svg {
                                                                            flex-shrink: 0;
                                                                        }

                                                                        /* Fields row */
                                                                        .fields {
                                                                            display: grid;
                                                                            grid-template-columns: 1fr auto 1fr 1fr auto;
                                                                            border: 1.5px solid var(--border);
                                                                            border-radius: 12px;
                                                                            overflow: hidden;
                                                                        }

                                                                        .field {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 10px;
                                                                            padding: 13px 16px;
                                                                            background: var(--surface);
                                                                            border-right: 1.5px solid var(--border);
                                                                            min-width: 0;
                                                                        }

                                                                            .field svg {
                                                                                color: var(--accent);
                                                                                flex-shrink: 0;
                                                                            }

                                                                            .field input {
                                                                                border: none;
                                                                                outline: none;
                                                                                background: transparent;
                                                                                font-family: inherit;
                                                                                font-size: 14px;
                                                                                color: var(--text);
                                                                                width: 100%;
                                                                                min-width: 0;
                                                                            }

                                                                                .field input::placeholder {
                                                                                    color: var(--text-muted);
                                                                                }

                                                                        .field-plus {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            justify-content: center;
                                                                            padding: 0 10px;
                                                                            background: var(--surface);
                                                                            border-right: 1.5px solid var(--border);
                                                                            cursor: pointer;
                                                                            color: var(--accent);
                                                                            font-size: 20px;
                                                                            min-width: 38px;
                                                                        }

                                                                        .date-field {
                                                                            display: flex;
                                                                            flex-direction: column;
                                                                            justify-content: center;
                                                                            padding: 10px 16px;
                                                                            background: var(--surface);
                                                                            border-right: 1.5px solid var(--border);
                                                                            min-width: 0;
                                                                            cursor: pointer;
                                                                            gap: 3px;
                                                                        }

                                                                        .date-field-label {
                                                                            font-size: 10px;
                                                                            font-weight: 600;
                                                                            color: var(--text-muted);
                                                                            letter-spacing: 0.05em;
                                                                            text-transform: uppercase;
                                                                        }

                                                                        .date-field-row {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 7px;
                                                                        }

                                                                            .date-field-row svg {
                                                                                color: var(--accent);
                                                                                flex-shrink: 0;
                                                                            }

                                                                        .date-val {
                                                                            font-size: 14px;
                                                                            font-weight: 600;
                                                                            color: var(--text);
                                                                            font-variant-numeric: tabular-nums;
                                                                        }

                                                                        .time-val {
                                                                            font-size: 14px;
                                                                            font-weight: 600;
                                                                            color: var(--accent);
                                                                            font-variant-numeric: tabular-nums;
                                                                        }

                                                                        /* CTA */
                                                                        .cta {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            justify-content: center;
                                                                            padding: 0 26px;
                                                                            background: var(--cta-bg);
                                                                            color: #fff;
                                                                            font-family: inherit;
                                                                            font-size: 15px;
                                                                            font-weight: 600;
                                                                            border: none;
                                                                            cursor: pointer;
                                                                            white-space: nowrap;
                                                                            transition: background 0.15s;
                                                                            min-width: 130px;
                                                                            gap: 8px;
                                                                        }

                                                                            .cta:hover {
                                                                                background: var(--cta-hover);
                                                                            }

                                                                        /* Sub-row */
                                                                        .sub-row {
                                                                            margin-top: 12px;
                                                                            display: flex;
                                                                            align-items: center;
                                                                            justify-content: space-between;
                                                                            flex-wrap: wrap;
                                                                            gap: 8px;
                                                                        }

                                                                        .age-btn {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 6px;
                                                                            background: none;
                                                                            border: none;
                                                                            font-family: inherit;
                                                                            font-size: 13px;
                                                                            color: var(--text-muted);
                                                                            cursor: pointer;
                                                                            padding: 4px 0;
                                                                        }

                                                                            .age-btn svg {
                                                                                color: var(--accent);
                                                                            }

                                                                        .status-row {
                                                                            display: flex;
                                                                            gap: 14px;
                                                                            flex-wrap: wrap;
                                                                        }

                                                                        .status-dot {
                                                                            display: flex;
                                                                            align-items: center;
                                                                            gap: 5px;
                                                                            font-size: 12px;
                                                                            color: var(--text-muted);
                                                                        }

                                                                        .dot {
                                                                            width: 8px;
                                                                            height: 8px;
                                                                            border-radius: 50%;
                                                                            flex-shrink: 0;
                                                                        }

                                                                        .dot-available {
                                                                            background: #108981;
                                                                        }

                                                                        .dot-booked {
                                                                            background: #F59E0B;
                                                                        }

                                                                        .dot-unavailable {
                                                                            background: #EF4444;
                                                                        }

                                                                        /* Responsive */
                                                                        @@media (max-width: 720px) {
                                                                            .fields

                                                                        {
                                                                            grid-template-columns: 1fr;
                                                                        }

                                                                        .field, .date-field, .field-plus {
                                                                            border-right: none;
                                                                            border-bottom: 1.5px solid var(--border);
                                                                        }

                                                                        .field-plus {
                                                                            padding: 10px 16px;
                                                                            justify-content: flex-start;
                                                                            min-width: unset;
                                                                        }

                                                                        .cta {
                                                                            padding: 16px;
                                                                            width: 100%;
                                                                            border-radius: 0 0 10px 10px;
                                                                        }

                                                                        }
                                                                    </style>

                                                                    <!-- Logo -->
                                                                    <div class="sevent-widget">

                                                                    <!-- Search card -->
                                                                    <div class="card">

                                                                        <!-- Tabs + manage -->
                                                                        <div class="top-row">
                                                                            <div class="tabs">
                                                                                <button class="tab active" onclick="setTab(this,'bilar')">
                                                                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <rect x="1" y="11" width="22" height="8" rx="2" />
                                                                                        <path d="M5 11V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4" />
                                                                                        <circle cx="7" cy="19" r="2" />
                                                                                        <circle cx="17" cy="19" r="2" />
                                                                                    </svg>
                                                                                    Bilar
                                                                                </button>
                                                                                <button class="tab" onclick="setTab(this,'transportbil')">
                                                                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <rect x="1" y="9" width="22" height="10" rx="2" />
                                                                                        <path d="M5 9V7a2 2 0 0 1 2-2h6l4 4" />
                                                                                        <circle cx="7" cy="19" r="2" />
                                                                                        <circle cx="17" cy="19" r="2" />
                                                                                    </svg>
                                                                                    Transportbil
                                                                                </button>
                                                                                <button class="tab" onclick="setTab(this,'motorcykel')">
                                                                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <circle cx="5.5" cy="17.5" r="3.5" />
                                                                                        <circle cx="18.5" cy="17.5" r="3.5" />
                                                                                        <path d="M15 6h-3l-2 5H5.5M15 6l3 5.5M9 11.5h6" />
                                                                                    </svg>
                                                                                    Motorcykel
                                                                                </button>
                                                                            </div>
                                                                        </div>

                                                                        <!-- Vehicle categories from Vehicle class -->
                                                                        <p class="categories-label">Fordonstyp</p>
                                                                        <div class="categories" id="cats">
                                                                            <button class="cat-pill active" onclick="toggleCat(this)">
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <rect x="1" y="11" width="22" height="8" rx="2" />
                                                                                    <path d="M5 11V7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4" />
                                                                                    <circle cx="7" cy="19" r="2" />
                                                                                    <circle cx="17" cy="19" r="2" />
                                                                                </svg>
                                                                                Kompaktbil
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <rect x="1" y="11" width="22" height="8" rx="2" />
                                                                                    <path d="M3 11V8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v3" />
                                                                                    <circle cx="7" cy="19" r="2" />
                                                                                    <circle cx="17" cy="19" r="2" />
                                                                                </svg>
                                                                                Kombi
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <!-- Electric bolt -->
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                                                                                </svg>
                                                                                Elbil
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <!-- Hybrid leaf -->
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z" />
                                                                                    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                                                                                </svg>
                                                                                Hybrid
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <rect x="1" y="9" width="22" height="10" rx="2" />
                                                                                    <path d="M5 9V7a2 2 0 0 1 2-2h6l4 4" />
                                                                                    <circle cx="7" cy="19" r="2" />
                                                                                    <circle cx="17" cy="19" r="2" />
                                                                                </svg>
                                                                                Skåpbil
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <!-- El-skåpbil -->
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <rect x="1" y="9" width="22" height="10" rx="2" />
                                                                                    <path d="M5 9V7a2 2 0 0 1 2-2h6l4 4" />
                                                                                    <circle cx="7" cy="19" r="2" />
                                                                                    <circle cx="17" cy="19" r="2" />
                                                                                    <path d="M16 3l-2 3h3l-2 3" stroke-width="1.5" />
                                                                                </svg>
                                                                                El-skåpbil
                                                                            </button>
                                                                            <button class="cat-pill" onclick="toggleCat(this)">
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <circle cx="5.5" cy="17.5" r="3.5" />
                                                                                    <circle cx="18.5" cy="17.5" r="3.5" />
                                                                                    <path d="M15 6h-3l-2 5H5.5M15 6l3 5.5M9 11.5h6" />
                                                                                </svg>
                                                                                Motorcykel
                                                                            </button>
                                                                        </div>

                                                                        <!-- Search fields -->
                                                                        <div class="fields">
                                                                            <div class="field">
                                                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <circle cx="11" cy="11" r="8" />
                                                                                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                                                                </svg>
                                                                                <input type="text" id="location" placeholder="Flygplats, stad eller adress" autocomplete="off">
                                                                            </div>

                                                                            <div class="field-plus" title="Annan plats för återlämning">
                                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <line x1="12" y1="5" x2="12" y2="19" />
                                                                                    <line x1="5" y1="12" x2="19" y2="12" />
                                                                                </svg>
                                                                            </div>

                                                                            <div class="date-field">
                                                                                <span class="date-field-label">Datum för Hämta upp</span>
                                                                                <div class="date-field-row">
                                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                                                                        <line x1="16" y1="2" x2="16" y2="6" />
                                                                                        <line x1="8" y1="2" x2="8" y2="6" />
                                                                                        <line x1="3" y1="10" x2="21" y2="10" />
                                                                                    </svg>
                                                                                    <span id="date-pickup" class="date-val">16 okt</span>
                                                                                    <span id="time-pickup" class="time-val">10:00</span>
                                                                                </div>
                                                                            </div>

                                                                            <div class="date-field">
                                                                                <span class="date-field-label">Datum för återlämning</span>
                                                                                <div class="date-field-row">
                                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                                                                        <line x1="16" y1="2" x2="16" y2="6" />
                                                                                        <line x1="8" y1="2" x2="8" y2="6" />
                                                                                        <line x1="3" y1="10" x2="21" y2="10" />
                                                                                    </svg>
                                                                                    <span id="date-return" class="date-val">20 okt</span>
                                                                                    <span id="time-return" class="time-val">10:00</span>
                                                                                </div>
                                                                            </div>

                                                                            <button class="cta" id="cta-btn">
                                                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <circle cx="11" cy="11" r="8" />
                                                                                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                                                                                </svg>
                                                                                Visa bilar
                                                                            </button>
                                                                        </div>

                                                                        <!-- Sub-row -->
                                                                        <div class="sub-row">
                                                                            <button class="age-btn">
                                                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                                                                    <circle cx="12" cy="7" r="4" />
                                                                                </svg>
                                                                                Förarens ålder 30+
