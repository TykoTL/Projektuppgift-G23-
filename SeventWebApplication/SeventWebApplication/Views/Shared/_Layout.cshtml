@inject SeventWebApplication.Models.Users.UserSession UserSession
@using SeventWebApplication
@using SeventWebApplication.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sevent</title>

    <script type="importmap"></script>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/SeventWebApplication.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm sevent-navbar border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div style="display: inline-flex;"> <img src="/lib/S_Icon.png" alt="Sevent Logo" style="height: 30px; width: auto;" /> <h4 style="color:white;">Sevent</h4></div> 
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @* Bokningsvisaren syns bara när man är inloggad. Personal ser alla, kunder sina egna *@
                        @if (UserSession.CurrentUser is SeventWebApplication.Models.Users.IBookingViewer)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Bookings" asp-action="Index">
                                    @(UserSession.CurrentUser is SeventWebApplication.Models.Users.IBookingManager ? "Alla bokningar" : "Mina bokningar")
                                </a>
                            </li>
                        }
                        @* Användarhantering, bara för admin *@
                        @if (UserSession.CurrentUser is SeventWebApplication.Models.Users.IAccountManager)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Users" asp-action="Index">Användarhantering</a>
                            </li>
                        }
                    </ul>
                    @* Inloggad? Visa namn + logga ut. Annars en länk till inloggningen *@
                    @{ var currentUser = UserSession.CurrentUser; }
                    <ul class="navbar-nav">
                        @if (currentUser != null)
                        {
                            <li class="nav-item"><span class="nav-link text-dark">@currentUser.Name (@currentUser.Role)</span></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-dark">Logga ut</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Logga in</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SeventWebApplication - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
