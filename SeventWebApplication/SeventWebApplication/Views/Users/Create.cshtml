@using SeventWebApplication.Models.Users
@using SeventWebApplication.Controllers
@model CreateUserForm
@{
    ViewData["Title"] = "Ny användare";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <a asp-action="Index" class="text-decoration-none">&larr; Tillbaka till användare</a>
        <h2 class="mt-2">Ny användare</h2>
        <p class="text-muted">Skapa ett konto åt en kund eller en anställd.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label class="form-label" asp-for="Name">Namn</label>
                <input class="form-control" asp-for="Name" required />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Mail">E-post</label>
                <input class="form-control" asp-for="Mail" type="email" required />
                <div class="form-text">Används för att logga in och går inte att ändra sen.</div>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Phone">Telefon</label>
                <input class="form-control" asp-for="Phone" />
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Password">Lösenord</label>
                <input class="form-control" asp-for="Password" type="password" required minlength="8" />
                <div class="form-text">Minst 8 tecken.</div>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="Role">Roll</label>
                @* Bara rollerna AccountService tillåter (Kund/Anställd i detta fall), så listan och reglerna aldrig glider isär *@
                <select class="form-select" asp-for="Role">
                    @foreach (var role in AccountService.AssignableRoles)
                    {
                        <option value="@role">@UsersController.RoleText(role)</option>
                    }
                </select>
            </div>

            <button class="btn btn-primary" type="submit">Skapa konto</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Avbryt</a>
        </form>
    </div>
</div>
